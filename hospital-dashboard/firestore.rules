rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Shared helpers
    // ---------------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    // Hospital/company accounts live in `admins` (super_admin) or `users`
    // (hospital_admin / driver) - see hospital-dashboard/src/services/authService.js
    // getUserProfile(), which checks `admins/{uid}` first, then falls back
    // to `users/{uid}`. Mirrored here so role()/hospitalId() match whichever
    // doc actually exists for the signed-in uid.
    function adminDocData() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function userDocData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function callerProfile() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        ? adminDocData()
        : userDocData();
    }

    function hasCallerProfile() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        || exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return signedIn() && hasCallerProfile() ? callerProfile().role : null;
    }

    function hospitalId() {
      return signedIn() && hasCallerProfile() ? callerProfile().hospitalId : null;
    }

    // 'admin' and 'super_admin' both show up across the two dashboards for
    // the same "company-wide" role - treat them as equivalent everywhere.
    function isSuperAdmin() {
      return role() == 'admin' || role() == 'super_admin';
    }

    function isHospitalAdmin() {
      return role() == 'hospital_admin';
    }

    function isDriverRole() {
      return role() == 'driver';
    }

    // Police officers are a separate concept with their own collection
    // (police_officers/{uid}) - see police dashboard/src/services/authService.js.
    // The officer sets their own password at registration, but the account
    // only counts as usable once an admin has flipped status to "approved".
    function policeDocData() {
      return get(/databases/$(database)/documents/police_officers/$(request.auth.uid)).data;
    }

    function isApprovedPolice() {
      return signedIn()
        && exists(/databases/$(database)/documents/police_officers/$(request.auth.uid))
        && policeDocData().status == 'approved'
        && policeDocData().isActive == true;
    }

    function sameHospital() {
      return resource.data.hospitalId == hospitalId();
    }

    function incomingSameHospital() {
      return request.resource.data.hospitalId == hospitalId();
    }

    function approvalStatusUnchanged() {
      return !('approvalStatus' in request.resource.data.diff(resource.data).affectedKeys());
    }

    function credentialFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'uid',
        'credentialsCreatedAt',
        'passwordChanged'
      ]);
    }

    function driverOwnDoc() {
      return resource.data.uid == request.auth.uid;
    }

    function driverPasswordChangedOnly() {
      return driverOwnDoc()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['passwordChanged'])
        && resource.data.passwordChanged == false
        && request.resource.data.passwordChanged == true;
    }

    function onlyApprovalStatusChangedByAdmin() {
      return isSuperAdmin()
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approvalStatus']);
    }

    function isActiveDriverLocationWrite() {
      let ambulance = get(/databases/$(database)/documents/ambulances/$(request.resource.data.ambulanceId)).data;
      return isDriverRole()
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.hospitalId == ambulance.hospitalId
        && ambulance.activeDriverId == request.auth.uid;
    }

    // -------------------------------------------------------------------
    // Hospital / company admin console + driver app
    // -------------------------------------------------------------------

    match /admins/{uid} {
      allow read: if signedIn() && (isSuperAdmin() || uid == request.auth.uid);
      allow write: if signedIn() && isSuperAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn() && (isSuperAdmin() || uid == request.auth.uid);
      allow write: if signedIn() && isSuperAdmin();
    }

    match /hospitals/{hospitalDocId} {
      allow read: if signedIn() && (isSuperAdmin() || isHospitalAdmin() || isApprovedPolice());
      allow write: if signedIn() && isSuperAdmin();
    }

    match /drivers/{driverId} {
      allow read: if signedIn() && (
        isSuperAdmin()
        || (isHospitalAdmin() && sameHospital())
        || (isDriverRole() && driverOwnDoc())
        // The police dashboard's tripAlertWatcher.js watches the whole
        // `drivers` collection for tripStatus transitions.
        || isApprovedPolice()
      );

      allow create: if signedIn() && (
        isSuperAdmin()
        || (isHospitalAdmin()
          && incomingSameHospital()
          && request.resource.data.approvalStatus == 'pending')
      );

      allow update: if signedIn() && (
        (isSuperAdmin() && onlyApprovalStatusChangedByAdmin())
        || (isHospitalAdmin()
          && sameHospital()
          && incomingSameHospital()
          && approvalStatusUnchanged()
          && credentialFieldsUnchanged())
        || (isDriverRole() && driverPasswordChangedOnly())
        // Driver app taps through trip milestones (tripStatus) on its own doc.
        || (isDriverRole()
          && driverOwnDoc()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tripStatus']))
      );

      allow delete: if signedIn() && isSuperAdmin();
    }

    match /pending_drivers/{requestId} {
      allow read: if signedIn() && (isSuperAdmin() || (isHospitalAdmin() && resource.data.hospitalId == hospitalId()));
      allow create: if signedIn() && (isSuperAdmin() || (isHospitalAdmin() && incomingSameHospital()));
      allow update, delete: if signedIn() && (isSuperAdmin() || (isHospitalAdmin() && resource.data.hospitalId == hospitalId()));
    }

    match /pending_ambulances/{requestId} {
      allow read: if signedIn() && (isSuperAdmin() || (isHospitalAdmin() && resource.data.hospitalId == hospitalId()));
      allow create: if signedIn() && (isSuperAdmin() || (isHospitalAdmin() && incomingSameHospital()));
      allow update, delete: if signedIn() && (isSuperAdmin() || (isHospitalAdmin() && resource.data.hospitalId == hospitalId()));
    }

    match /ambulances/{ambulanceId} {
      allow read: if signedIn() && (
        isSuperAdmin()
        || (isHospitalAdmin() && sameHospital())
        || (isDriverRole() && resource.data.activeDriverId == request.auth.uid)
        || isApprovedPolice()
      );

      allow create: if signedIn() && (
        isSuperAdmin()
        || (isHospitalAdmin()
          && incomingSameHospital()
          && request.resource.data.approvalStatus == 'pending')
      );

      allow update: if signedIn() && (
        (isSuperAdmin() && onlyApprovalStatusChangedByAdmin())
        || (isHospitalAdmin() && sameHospital() && incomingSameHospital() && approvalStatusUnchanged())
        || (isDriverRole()
          && resource.data.approvalStatus == 'approved'
          && request.auth.uid in resource.data.assignedDrivers
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeDriverId'])
          && (request.resource.data.activeDriverId == request.auth.uid || request.resource.data.activeDriverId == null))
      );

      allow delete: if signedIn() && isSuperAdmin();
    }

    match /emergencies/{emergencyId} {
      allow read: if signedIn() && (
        isSuperAdmin()
        || (isHospitalAdmin() && sameHospital())
        || (isDriverRole() && resource.data.driverId == request.auth.uid)
        || isApprovedPolice()
      );
      allow write: if signedIn() && isSuperAdmin();
    }

    match /live_locations/{ambulanceId} {
      allow read: if signedIn() && (
        isSuperAdmin()
        || (isHospitalAdmin() && sameHospital())
        || (isDriverRole() && resource.data.driverId == request.auth.uid)
        || isApprovedPolice()
      );
      allow write: if signedIn() && isActiveDriverLocationWrite();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && (
        isSuperAdmin()
        || (isHospitalAdmin() && sameHospital())
      );
      allow create: if signedIn() && isSuperAdmin();
      allow update: if signedIn() && (
        isSuperAdmin()
        || (isHospitalAdmin() && sameHospital() && incomingSameHospital()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']))
      );
      allow delete: if signedIn() && isSuperAdmin();
    }

    // Shared trip/approval activity log. The police dashboard reads the
    // whole collection and filters client-side to `trip_*` entries
    // (firebaseDataService.js isTripActivity) - it only ever WRITES entries
    // with that same `trip_` prefix, via tripAlertWatcher.js.
    match /activity_logs/{logId} {
      allow read: if signedIn() && (
        isSuperAdmin()
        || (isHospitalAdmin() && (resource.data.hospitalId == hospitalId() || resource.data.hospitalId == null))
        || isApprovedPolice()
      );
      allow create: if signedIn() && (
        isSuperAdmin()
        || isHospitalAdmin()
        || (isApprovedPolice() && request.resource.data.action.matches('trip_.*'))
      );
      allow update, delete: if signedIn() && isSuperAdmin();
    }

    match /analytics/{docId} {
      allow read: if signedIn() && (isSuperAdmin() || isHospitalAdmin() || isApprovedPolice());
      allow write: if signedIn() && isSuperAdmin();
    }

    match /rejected_requests/{requestId} {
      allow read, write: if signedIn() && isSuperAdmin();
    }

    // -------------------------------------------------------------------
    // Police dashboard
    // -------------------------------------------------------------------

    // Single system-status heartbeat doc the police dashboard subscribes to.
    match /systemStatus/{docId} {
      allow read: if signedIn() && (isSuperAdmin() || isHospitalAdmin() || isApprovedPolice());
      allow write: if signedIn() && isSuperAdmin();
    }

    // Police-only trip-milestone alerts, written client-side by
    // tripAlertWatcher.js as officers watch trip status change.
    match /police_alerts/{alertId} {
      allow read: if signedIn() && (isSuperAdmin() || isApprovedPolice());
      allow create: if signedIn() && isApprovedPolice();
      allow update: if signedIn() && isApprovedPolice()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt']);
      allow delete: if signedIn() && (isSuperAdmin() || isApprovedPolice());
    }

    // Traffic incidents officers log from Traffic Control.
    match /trafficReports/{reportId} {
      allow read: if signedIn() && (isSuperAdmin() || isApprovedPolice());
      allow create, update, delete: if signedIn() && isApprovedPolice();
    }

    // Police officer profiles. `uid` == the officer's own Firebase Auth uid,
    // created directly by the officer at registration (Register.jsx ->
    // authService.requestPoliceAccess) with status "pending" / isActive
    // false, and only flipped to "approved" by an admin from the admin
    // dashboard's Pending Police Officers screen.
    match /police_officers/{uid} {
      // Login-by-badge-ID has to resolve badge -> email BEFORE the officer
      // is signed in (authService.js resolveLoginEmail runs pre-auth), so
      // this collection has to be readable without an existing session for
      // that lookup to work at all. No passwords live here - those are only
      // ever in Firebase Auth.
      allow read: if true;

      allow create: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'police'
        && request.resource.data.status == 'pending'
        && request.resource.data.isActive == false;

      // Only an admin can approve/reject or change station/radius/isActive.
      allow update: if signedIn() && isSuperAdmin();
      allow delete: if signedIn() && isSuperAdmin();
    }

    // Admin dashboard's review queue for Register.jsx submissions.
    match /pending_police_officers/{requestId} {
      allow read: if signedIn() && isSuperAdmin();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if signedIn() && isSuperAdmin();
    }
  }
}
