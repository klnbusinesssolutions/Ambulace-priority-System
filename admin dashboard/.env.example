# Copy this file to .env.local and fill in your Firebase project's web app config
# (Firebase console → Project settings → General → Your apps → SDK setup and config).
#
# Without these set, the dashboard automatically runs in local demo mode using
# src/services/mockData.js instead of live Firestore data — see AuthContext.jsx
# and OpsContext.jsx.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
